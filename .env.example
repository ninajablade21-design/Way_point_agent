# OPTIONAL. Leave this file untouched (or don't create .env at all) to run in
# local demo mode, where reports are stored in your browser's localStorage.
#
# To use Supabase: copy this file to ".env" and fill in the two values from
# Supabase Dashboard -> Project Settings -> API.
# Use ONLY the public "anon"/"publishable" key. NEVER put a service_role key here:
# every VITE_ variable is bundled into the public website.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
